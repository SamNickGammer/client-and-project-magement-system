// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum AccessLevel {
  DIRECTOR
  HR
  DEVELOPER
  MARKETING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
  CLIENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  name               String?
  accessLevel        AccessLevel?
  image              String?
  phone              String?
  status             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lastLoginAt        DateTime?
  currentTokenExpiry DateTime?


}

model Employee {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  position  String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  assignedLeads      Lead[]
  assignedProjects   ProjectAssignment[]
  assignedTasks      TaskAssignment[]
}

model Contact {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  position    String?
  notes       String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Many-to-many
  leads       LeadContact[]
}

model Lead {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      LeadStatus @default(NEW)
  value       Float?
  company     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  contacts     LeadContact[]
  projects     Project[] // Added back relation
  
  // New fields
  tags         String[]
  chatHistory  Json?     @default("[]")
  attachments  LeadAttachment[]
  checklists   LeadChecklist[]
}

model LeadChecklist {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  priority    String?  // "low", "medium", "high"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  checklistId String
  checklist   LeadChecklist @relation(fields: [checklistId], references: [id])
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  status      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  lead        Lead?     @relation(fields: [leadId], references: [id]) // Changed from Client
  leadId      String?    // Changed from clientId
  tasks       Task[]
  assignments ProjectAssignment[]
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  priority    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  project     Project    @relation(fields: [projectId], references: [id])
  projectId   String
  assignments TaskAssignment[]
}

// Many-to-Many Junction Tables
model LeadContact {
  leadId     String
  contactId  String

  lead       Lead     @relation(fields: [leadId], references: [id])
  contact    Contact  @relation(fields: [contactId], references: [id])

  @@id([leadId, contactId])
}

model ProjectAssignment {
  projectId  String
  employeeId String

  project    Project  @relation(fields: [projectId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([projectId, employeeId])
}

model TaskAssignment {
  taskId     String
  employeeId String

  task       Task     @relation(fields: [taskId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([taskId, employeeId])
}

model LeadAttachment {
  id          String   @id @default(uuid())
  name        String
  url         String
  size        Int
  type        String
  createdAt   DateTime @default(now())
  
  uploadedBy  String?  // Can link to User/Employee ID if needed, keeping simple for now
  
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
}
